from os import PathLike
from pathlib import Path
from typing import Callable, ClassVar, Self, TypeVar

_Path = str | bytes | PathLike[str] | PathLike[bytes]
_T = TypeVar("_T")

class FixtureState:
    def path(self) -> Path: ...
    def is_uninitialized(self) -> bool: ...

class Creation:
    CopyFromReadOnly: ClassVar[Creation]
    Execute: ClassVar[Creation]

class TempDir:
    def path(self) -> Path: ...
    def close(self) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, exc_type: object, exc: object, tb: object) -> None: ...

def fixture_path(path: _Path) -> Path: ...
def fixture_bytes(path: _Path) -> bytes: ...
def fixture_has_symlinks(fixture_root: _Path) -> bool: ...
def scripted_fixture_read_only(script_name: _Path) -> Path: ...
def scripted_fixture_read_only_needs_archive(script_name: _Path) -> Path: ...
def scripted_fixture_read_only_with_args(script_name: _Path, args: list[str]) -> Path: ...
def scripted_fixture_read_only_with_post(script_name: _Path, version: int, post_process: Callable[[FixtureState], _T]) -> tuple[Path, _T]: ...
def scripted_fixture_read_only_with_args_with_post(script_name: _Path, args: list[str], version: int, post_process: Callable[[FixtureState], _T]) -> tuple[Path, _T]: ...
def scripted_fixture_writable(script_name: _Path) -> TempDir: ...
def scripted_fixture_writable_with_args(script_name: _Path, args: list[str], mode: Creation) -> TempDir: ...
def scripted_fixture_writable_with_post(script_name: _Path, version: int, post_process: Callable[[FixtureState], _T]) -> tuple[TempDir, _T]: ...
def scripted_fixture_writable_with_args_with_post(script_name: _Path, args: list[str], mode: Creation, version: int, post_process: Callable[[FixtureState], _T]) -> tuple[TempDir, _T]: ...
def rust_fixture_read_only(name: str, version: int, make_fixture: Callable[[FixtureState], _T]) -> tuple[Path, _T]: ...
def rust_fixture_writable(name: str, version: int, mode: Creation, make_fixture: Callable[[FixtureState], _T]) -> tuple[TempDir, _T]: ...
def git(current_dir: _Path, arguments: str) -> str: ...
